from collections import deque

vertices = []
matriz = []

def inserir_vertice(v):
  if v not in vertices:
    vertices.append(v)
    for linha in matriz:
      linha.append(0)
    matriz.append([0] * len(vertices))
    print(f"Vertice {v} foi adicionado ! ")
  else:
    print("O vertice adicionado ja existe !")

def remover_vertice(v):
  if v in vertices:
    idx = vertices.index(v)
    vertices.remove(v)
    matriz.pop(idx)
    for linha in matriz:
      linha.pop(idx)
    print(f"Vertice {v} foi removido !")
  else:
    print(f"O vertice {v} nao existe !")

def inserir_aresta(u, v):
  if u not in vertices:
    inserir_vertice(u)
  if v not in vertices:
    inserir_vertice(v)

  i = vertices.index(u)
  j = vertices.index(v)

  matriz[i][j] = 1
  matriz[j][i] = 1
  print(f"A aresta entre '{u}' e '{v}' foi adicionada !")

def remover_aresta(u, v):
  if u in vertices and v in vertices:
    i = vertices.index(u)
    j = vertices.index(v)
    matriz[i][j] = 0
    matriz[j][i] = 0
    print(f"A aresta entre '{u}' e '{v}' foi removida com sucesso !")
  else:
    print("A aresta digitada nao existe !")

def calcular_grau(v):
  if v in vertices:
    i = vertices.index(v)
    grau = sum(matriz[i])
    print(f"O grau do vertice '{v}' é {grau}.")
    return grau
  else:
    print(f"O vertice '{v}' não existe.")
    return 0

def verificar_aresta(u, v):
  if u in vertices and v in vertices:
    i = vertices.index(u)
    j = vertices.index(v)
    if matriz[i][j] == 1:
      print("A aresta digitada existe !")
      return True
  print("A aresta digitada nao existe !")
  return False

def listar_vizinho(v):
  if v in vertices:
    i = vertices.index(v)
    vizinhos = []
    for j in range(len(vertices)):
      if matriz[i][j] == 1:
        vizinhos.append(vertices[j])
    print(f"Vizinhos do vertice '{v}': {vizinhos}")
  else:
    print(f"O vertice '{v}' não existe ou nao possui vizinhos.")

def verificar_percurso(percurso):
  for i in range(len(percurso) - 1):
    u = percurso[i]
    v = percurso[i + 1]
    if u not in vertices or v not in vertices or matriz[vertices.index(u)][vertices.index(v)] == 0:
      print(f"O percurso {percurso} nao é possivel (falha com os vertices '{u}' e '{v}') . ")
      return False
  print(f"O percurso {percurso} é possivel .")
  return True

def busca_largura(inicio):
    if inicio not in vertices:
        print(f"O vértice '{inicio}' não existe no grafo.")
        return []

    visitados = set()
    fila = deque([inicio])
    visitados.add(inicio)
    ordem_visita = []

    while fila:
        atual = fila.popleft()
        ordem_visita.append(atual)
        i = vertices.index(atual)

        for j in range(len(vertices)):
            if matriz[i][j] == 1:
                vizinho = vertices[j]
                if vizinho not in visitados:
                    visitados.add(vizinho)
                    fila.append(vizinho)

    print(f"Ordem de visitação (BFS) a partir de '{inicio}': {ordem_visita}")
    return ordem_visita

def menor_caminho_bfs(inicio, destino):
    """2 - Implementação da busca de menor caminho utilizando Busca em Largura[cite: 2]"""
    if inicio not in vertices or destino not in vertices:
        print(f"Um ou ambos os vértices ('{inicio}', '{destino}') não existem no grafo.")
        return []

    if inicio == destino:
        print(f"O vértice de início e destino são iguais. Caminho: {[inicio]}")
        return [inicio]

    visitados = set()
    fila = deque([inicio])
    visitados.add(inicio)
    pais = {inicio: None}
    encontrou = False
    while fila:
        atual = fila.popleft()

        if atual == destino:
            encontrou = True
            break

        i = vertices.index(atual)
        for j in range(len(vertices)):
            if matriz[i][j] == 1:
                vizinho = vertices[j]
                if vizinho not in visitados:
                    visitados.add(vizinho)
                    pais[vizinho] = atual
                    fila.append(vizinho)

    if not encontrou:
        print(f"Não existe caminho entre '{inicio}' e '{destino}'.")
        return []

    caminho = []
    atual = destino
    while atual is not None:
        caminho.append(atual)
        atual = pais[atual]
    caminho.reverse()

    print(f"Menor caminho entre '{inicio}' e '{destino}': {caminho} (Total de arestas: {len(caminho) - 1})")
    return caminho

def exibir_grafo():
  if not vertices:
    print("O grafo esta vazio.")
    return
  print("Vertices: ", vertices)
  print("Matriz de adjacencia: ")
  for linha in matriz:
    print(linha)

