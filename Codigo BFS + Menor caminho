      remover_vertice(v)
    elif escolha == "4":
      u = input("Digite o primeiro vertice: ").strip()
      v = input("Digite o segundo vertice: ").strip()
      remover_aresta(u, v)
    elif escolha == "5":
      v = input("Digite o nome do vertice para calcular o grau: ").strip()
      calcular_grau(v)
    elif escolha == "6":
      u = input("Digite o primeiro vertice: ").strip()
      v = input("Digite o segundo vertice: ").strip()
      verificar_aresta(u, v)
    elif escolha == "7":
